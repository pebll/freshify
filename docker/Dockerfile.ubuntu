# Dockerfile.ubuntu
FROM ubuntu:latest

# Update package list and install common tools
RUN apt-get update && apt-get install -y \
    vim \
    git \
    curl \
    wget \
    sudo \
    bash-completion \
    && rm -rf /var/lib/apt/lists/*

# Create a user (optional, but good practice)
RUN useradd -m -s /bin/bash developer && \
    echo 'developer ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers

# Set working directory
WORKDIR /home/developer

# Switch to developer user
USER developer

# Set up bash prompt and environment
RUN echo 'export PS1="\[\033[01;32m\]\u@ubuntu-container\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ "' >> ~/.bashrc

CMD ["/bin/bash"]
